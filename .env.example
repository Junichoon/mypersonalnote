# personalmemo MySQL Configuration
# Copy this file to .env and fill in your values

# MySQL Connection
MEMO_MYSQL_HOST=localhost
MEMO_MYSQL_PORT=3306
MEMO_MYSQL_USER=root
MEMO_MYSQL_PASSWORD=your_password_here
MEMO_MYSQL_DATABASE=personalmemo

# Flask Secret Key (change this!)
OPENCLAW_MEMO_SECRET=change-this-to-a-random-secret
